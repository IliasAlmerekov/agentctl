{
  "name": "agentctl",
  "version": "0.1.0",
  "description": "Sub-agent control plane for Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IliasAlmerekov/agentctl.git"
  },
  "bugs": {
    "url": "https://github.com/IliasAlmerekov/agentctl/issues"
  },
  "homepage": "https://github.com/IliasAlmerekov/agentctl#readme",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev:daemon": "bun run --watch src/daemon/server.ts",
    "build:hooks": "bun build --compile --target bun src/hooks/pre-tool-use.ts --outfile dist/hooks/pre-tool-use && bun build --compile --target bun src/hooks/post-tool-use.ts --outfile dist/hooks/post-tool-use && bun build --compile --target bun src/hooks/subagent-start.ts --outfile dist/hooks/subagent-start && bun build --compile --target bun src/hooks/subagent-stop.ts --outfile dist/hooks/subagent-stop",
    "build:daemon": "bun build --compile --target bun src/daemon/server.ts --outfile dist/agentctl-daemon",
    "build:cli": "bun build --compile --target bun src/cli/index.ts --outfile dist/agentctl --define 'process.env.DEV=\"\"'",
    "build:local": "bun run build:hooks && bun run build:daemon && bun run build:cli",
    "build:release": "bun run src/release/build-artifacts.ts",
    "build": "bun run build:release",
    "check:public-doc-drift": "bun run scripts/check-public-doc-drift.ts",
    "check:public-install-url": "bun run scripts/check-public-install-url.ts",
    "measure:hooks": "bun run scripts/measure-hook-latency.ts",
    "smoke:install": "bash scripts/smoke-install.sh",
    "smoke:install:public": "AGENTCTL_SMOKE_INSTALL_SOURCE=public bash scripts/smoke-install.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12",
    "ink": "^5",
    "react": "^18",
    "react-devtools-core": "^4.19.1"
  },
  "devDependencies": {
    "@types/react": "^18",
    "bun-types": "latest",
    "typescript": "^5"
  }
}
